# Copy to .env and fill in. Never commit .env.

# Private data repo the local app pulls from
DATA_REPO_URL=https://github.com/<your-user>/hidden-hire-data.git

# Job sources
REED_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# LLM providers (use any one or more)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=